namespace ui;

import 'types.loom';

type Size = 'small' | 'medium' | 'large';
type ExtraSize = Size | 'huge';
type Intent = 'danger';

class Card {
    slot body;

    {%
        padding: 1rem;
        background-color: white;
    %}

    slot image {%
        border: 2px solid red;
    %}

    slot title {%
        font-size: 2rem;
        color: red;
    %}
}

class ProductCard extends Card {
    {% background-color: blue; %}

    slot image {%
        opacity: .5;
    %}
}