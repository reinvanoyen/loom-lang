namespace ui;

import 'types.loom';

type Size = 'small' | 'medium' | 'small';
type ExtraSize = Size | 'huge';
type Intent = 'danger';

type Word = string;

class Button {

    @size: = 'medium';
    @intent: Intent | 'flashy' = 'flashy';

    what;

    slot link;

    {%
        position: relative;
        width: 100px;
        height: 90px;
        animation: heartbeat 1s infinite;
    %}
}

augment class Button {
    {%
        position: relative;
        width: 100px;
        height: 90px;
        animation: heartbeat 1s infinite;
    %}
}

class Link extends Button {

}

class Label {{%
    color: red;
%}}